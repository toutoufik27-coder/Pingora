# Copy to .env.local for development or set these in your hosting provider.
# Everything is optional locally: without them the app uses an embedded database,
# logs emails instead of sending them, and unlocks every feature without billing.

# Public URL of the app, used in emails, portal links, cookies and the sitemap.
APP_URL=https://app.example.com

# Postgres connection string (Neon, Supabase, RDS…). Unset = embedded PGlite in ./.data
DATABASE_URL=

# Email through Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="CoHost Ledger <statements@example.com>"

# Billing through Lemon Squeezy (https://lemonsqueezy.com). All four are needed to enable billing.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
